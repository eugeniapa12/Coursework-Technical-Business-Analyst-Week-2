    <bpmn:textAnnotation id="TextAnnotation_0n1ug57">
      <bpmn:text>Reduced admin effort: reclaims 3.31 hrs/agent/day by eliminating manual spreadsheet tracking, physical receipt generation and manual dialer exclusions.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1wae2ym">
      <bpmn:text>Reduced admin effort</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1av7c7j" associationDirection="None" sourceRef="DataStoreReference_07ff117" targetRef="TextAnnotation_1wae2ym" />
    <bpmn:association id="Association_0en8h1i" associationDirection="None" sourceRef="Activity_1aqhrev" targetRef="TextAnnotation_0n1ug57" />
    <bpmn:textAnnotation id="TextAnnotation_1s1w019">
      <bpmn:text>Faster next action: Easy self-service reduces long phone queues + customer can sort out their accounts 24/7</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0q9ue39" associationDirection="None" sourceRef="Flow_15qesa2" targetRef="TextAnnotation_1s1w019" />
    <bpmn:textAnnotation id="TextAnnotation_0abitzr">
      <bpmn:text>Improved follow-up consistency: Increase kept-promise rates.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1srfo5d" associationDirection="None" sourceRef="Activity_0r1ofop" targetRef="TextAnnotation_0abitzr" />
